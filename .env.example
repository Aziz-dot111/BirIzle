# Bir Izle - Firebase Frontend Configuration
# Replace these placeholder values with your real project credentials from the Firebase Console:
# https://console.firebase.google.com -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# Note:
# 1. Do NOT put Firebase Admin SDK service account private keys here!
# 2. Rename or copy this file to .env.local to test locally.
# 3. .env and .env.local are ignored by git to protect your setup.
